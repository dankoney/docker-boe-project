# Copy this file to .env and set your values (uncomment the lines you need).
# The API and docker-compose read from .env; .env.example is not used at runtime.
# DB (used when running API outside Docker, or override in compose)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASS=postgres

# Frontend → API URL (only when running Streamlit outside Docker)
# API_BASE_URL=http://127.0.0.1:8000

# Registration: only allow this email domain (default: shippers.org.gh)
# ALLOWED_EMAIL_DOMAIN=shippers.org.gh

# Auth cookie encryption (set a strong secret in production so login survives reload)
# COOKIES_PASSWORD=your-long-random-secret

# Base URL of the Streamlit app (for verification and password-reset links in emails)
# APP_BASE_URL=http://localhost:8501

# Gmail SMTP — required for verification and password-reset emails. Copy to .env and uncomment:
# SMTP_USER=your@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_FROM_LABEL=Statistics Portal

# Optional: recipient for email test (scripts/test_email.py or POST /auth/test-email)
# TEST_EMAIL=you@example.com
